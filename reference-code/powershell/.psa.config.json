// psa.py configuration for the reference-code/powershell canon module.
//
// Disabled rules (by-design; this canon is the reference implementation of the
// shared helpers used by the consumer scripts, so it inherits their by-design
// rule selection):
//   PSA6003 (plural-noun functions): Initialize-RuntimeDirectories and
//     Invoke-CleanupDirectories operate over collections; the plural noun is
//     the accurate description. Mirrors the consumers' .psa.config.json.
//   PSA7003 (non-ASCII script body): the canon is ASCII-only, so this never
//     fires; disabled to match the consumer baseline and avoid coupling to
//     that default-on rule's future evolution.
//
// Enabled rules (LLM-assisted-maintenance guardrails; the canon adopts the
// same strict stance as the Part-A canonical holder):
//   PSAP0003 / PSAP0004 / PSAP0005 - no per-revision inline tags, no in-body
//     CHANGELOG blocks, and no rNN references in comment bodies. The canonical
//     markers carry a SemVer canonical_version (e.g. 0.1.0), deliberately NOT
//     an rNN token, so markers do not trip PSAP0005 while revision-anchored
//     prose in bodies remains caught.
//
// External-scope $Script: contract (psa2013_known_script_vars; psa.py 4.3.0+):
//   the canon holds shared helpers split out of the consumer scripts. Those
//   helpers READ/MUTATE $Script: session state (debug-trace stacks/counters,
//   phase timings, script-root/-start) that the CONSUMING script owns and
//   initialises - not the per-helper file. Under PSA2013 (read-never-assigned,
//   error) and PSA2008 (mutate-without-init, info) these intentional external-
//   scope accesses would be false positives. The names below were established
//   by per-unit inspection as consumer-owned globals (verified initialised in
//   the consumers, e.g. update-windows-server-iso); they are DECLARED here as
//   an intentional external-scope dependency, not a blanket suppression. Names
//   NOT listed still fire, so genuine canon-local typos remain caught.
// Known external cmdlets (psa2010_known_cmdlets): PSA2010 flags calls to
//   functions/cmdlets not defined in the scanned set and not in PowerShell's
//   built-in list. The canon-test gate runner (tests/Invoke-CanonTests.ps1) drives
//   the Pester module, whose cmdlets are legitimate external dependencies declared
//   here (the runner Import-Module Pester before using them). This is an explicit
//   external-dependency declaration, like psa2013_known_script_vars - not a blanket
//   disable of PSA2010, so genuine undefined-function typos elsewhere still fire.
{
  "enable": [
    "PSAP0003",
    "PSAP0004",
    "PSAP0005"
  ],
  "disable": [
    "PSA6003",
    "PSA7003"
  ],
  "psa2010_known_cmdlets": [
    "Invoke-Pester",
    "New-PesterConfiguration"
  ],
  "psa2013_known_script_vars": [
    "CurrentPhaseId",
    "CurrentPhaseStart",
    "DebugTraceAutoExportDir",
    "DebugTraceAutoExportEnabled",
    "DebugTraceCompletedCap",
    "DebugTraceCompletedFrames",
    "DebugTraceEventSeq",
    "DebugTraceHistoryCap",
    "DebugTraceJsonDepth",
    "DebugTraceJsonlBuffer",
    "DebugTraceJsonlBufferCap",
    "DebugTraceJsonlEnabled",
    "DebugTraceJsonlErrorCount",
    "DebugTraceJsonlLastError",
    "DebugTraceJsonlLineCap",
    "DebugTraceJsonlPath",
    "DebugTraceJsonlWriteCount",
    "DebugTracePhaseRegistry",
    "DebugTraceStack",
    "PhaseTimings",
    "ScriptRoot",
    "ScriptStartTime",
    "ScriptTag"
  ]
}
