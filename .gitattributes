# =============================================================================
# .gitattributes for ai-generated-artifacts
# =============================================================================
# Purpose:
#   - Force consistent line endings across Windows/Linux/macOS contributors.
#   - Mark binary file types so Git does not try to diff or merge them.
#   - Configure GitHub's `linguist` so the "Languages" stats reflect actual
#     authored code rather than vendored or generated content.
# =============================================================================

# Default: treat unspecified text files as text and let Git auto-normalize
# line endings to LF on commit. Tools on Windows still see CRLF on checkout
# because of the eol attribute below where it matters.
* text=auto

# -----------------------------------------------------------------------------
# Line-ending discipline by language
# -----------------------------------------------------------------------------

# PowerShell scripts: UTF-8 working-tree encoding, CRLF on disk.
# Windows PowerShell 5.1 reads UTF-8-BOM+CRLF unambiguously; LF on Windows
# can interact badly with cp932 fallback. The working-tree-encoding=UTF-8
# attribute documents the intent and protects against accidental Shift-JIS
# or UTF-16 re-encoding by third-party editors on ja-JP Windows hosts.
# Note: this attribute does NOT enforce the UTF-8 BOM byte sequence itself.
# BOM enforcement is performed at lint time by psa.py rule PSA7001
# (see scripts/python/powershell-static-analyzer/).
*.ps1     text working-tree-encoding=UTF-8 eol=crlf
*.psm1    text working-tree-encoding=UTF-8 eol=crlf
*.psd1    text working-tree-encoding=UTF-8 eol=crlf

# Shell / Bash / Python: LF only (Unix tooling, including Linux runtimes).
*.sh      text eol=lf
*.bash    text eol=lf
*.py      text eol=lf
*.pyw     text eol=lf

# Generic config / data formats: LF on disk for consistency.
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.conf    text eol=lf
*.cfg     text eol=lf

# Markdown / plain documentation: LF (renders identically anywhere).
*.md      text eol=lf
*.markdown text eol=lf
*.txt     text eol=lf
*.rst     text eol=lf

# Web assets (rarely present, but in case any artifact ships them):
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf

# -----------------------------------------------------------------------------
# Binary file types — never auto-convert line endings, never diff
# -----------------------------------------------------------------------------

# Office / publishable documents
*.docx    binary
*.xlsx    binary
*.xlsm    binary
*.pptx    binary
*.pdf     binary

# Images
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.bmp     binary
*.tif     binary
*.tiff    binary
*.webp    binary

# Archives
*.zip     binary
*.gz      binary
*.tar     binary
*.tgz     binary
*.7z      binary
*.xz      binary
*.bz2     binary

# Misc binary
*.bin     binary
*.exe     binary
*.dll     binary

# -----------------------------------------------------------------------------
# GitHub Linguist hints
# -----------------------------------------------------------------------------
# These affect only the "Languages" bar on the GitHub repository page; they
# do not change how Git treats the files.

# Reference / illustrative code that is not the maintainer's authored work
# (none in this repo today; placeholder for future).
# vendored-stuff/*  linguist-vendored

# AI prompt files are markdown documentation, not "code" — exclude from
# language stats so they don't dominate.
prompts/**/*.md         linguist-documentation
study-notes/**/*.md     linguist-documentation

# Research articles are documentation, not source code.
research/**/*.md        linguist-documentation

# Templates with placeholder syntax — documentation, not source code.
templates/**/*.md       linguist-documentation

# README/SPEC/TESTING markdown across the tree are documentation.
**/README.md            linguist-documentation
**/README.*.md          linguist-documentation
**/SPEC.md              linguist-documentation
**/SPEC.*.md            linguist-documentation
**/TESTING.md           linguist-documentation
**/TESTING.*.md         linguist-documentation
**/CONTRIBUTING.md      linguist-documentation
**/CODE_OF_CONDUCT.md   linguist-documentation
**/SECURITY.md          linguist-documentation
**/CHANGELOG.md         linguist-documentation
