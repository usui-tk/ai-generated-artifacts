{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/usui-tk/ai-generated-artifacts/projects/powershell-update-windows-server-iso/schema/config-v3.0.schema.json",
  "title": "Windows Server ISO Updater - per-OS config profile (Config Schema v3.0)",
  "description": "Machine-readable contract for data/config-Server<OsKey>.json. Mirrors SPEC section B.4. Config Schema v3.0 rebuilds the patch model for the Microsoft Update Catalog data source: PatchBaseline.Lines[] (a common-core item with a Kind field) replaces NeutralPatches[]/Type, and a top-level PatchModel discriminator (separate-ssu/embedded-ssu/embedded-ssu-du/uup-checkpoint) governs which Kinds are required vs forbidden via the allOf if/then blocks. The uup-checkpoint model carries the checkpoint cumulative baseline as Kind 'Checkpoint' (co-located with the target LCU for DISM PackagePath-folder discovery; never applied standalone) and forbids Kind 'SSU'. Validated in CI by tests/config_schema_test.py; this schema and the configs are a matched pair.",
  "type": "object",
  "required": [
    "Schema",
    "OsKey",
    "PatchModel",
    "Common",
    "PatchBaseline"
  ],
  "properties": {
    "Schema": {
      "type": "string",
      "const": "3.0",
      "description": "Top-level config schema version. SPEC B.4."
    },
    "OsKey": {
      "type": "string",
      "enum": [
        "Server2016",
        "Server2019",
        "Server2022",
        "Server2025"
      ],
      "description": "OS identifier; matches the config filename suffix."
    },
    "PatchModel": {
      "type": "string",
      "enum": [
        "separate-ssu",
        "embedded-ssu",
        "embedded-ssu-du",
        "uup-checkpoint"
      ],
      "description": "Per-OS servicing model discriminator. 2016 separate-ssu; 2019 embedded-ssu; 2022 embedded-ssu-du; 2025 uup-checkpoint. Drives the required/forbidden Kinds (allOf below) and the script's per-OS apply branch."
    },
    "Common": {
      "$ref": "#/definitions/Common"
    },
    "PatchBaseline": {
      "$ref": "#/definitions/PatchBaseline"
    },
    "Pca2023": {
      "$ref": "#/definitions/Pca2023"
    },
    "AutoRefreshPolicy": {
      "$ref": "#/definitions/AutoRefreshPolicy"
    },
    "LanguageSpecific": {
      "$ref": "#/definitions/LanguageSpecific"
    },
    "_meta": {
      "type": "object",
      "description": "Informational provenance stamp (scriptVersion / generatedAt). Written by Save-ConfigWithBaseline.",
      "required": [
        "scriptVersion",
        "generatedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "scriptVersion": {
          "type": "string",
          "description": "Code version of the script that last wrote this config."
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp (yyyy-MM-ddTHH:mm:ssZ) when this config was last written."
        }
      }
    }
  },
  "patternProperties": {
    "^_": {
      "description": "Provenance / verification fields written by the script at runtime. Underscore-prefixed keys are reserved for machine-written metadata and are allowed anywhere."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "PatchModel": {
            "const": "separate-ssu"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "SSU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "LCU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "DotNet"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SafeOSDU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SetupDU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "PatchModel": {
            "const": "embedded-ssu"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "LCU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "DotNet"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SSU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SafeOSDU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SetupDU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "PatchModel": {
            "const": "embedded-ssu-du"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "LCU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "DotNet"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "SafeOSDU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SSU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SetupDU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "PatchModel": {
            "const": "uup-checkpoint"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "LCU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "Checkpoint"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "DotNet"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "contains": {
                      "properties": {
                        "Kind": {
                          "const": "SafeOSDU"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "PatchBaseline": {
                "properties": {
                  "Lines": {
                    "not": {
                      "contains": {
                        "properties": {
                          "Kind": {
                            "const": "SSU"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "definitions": {
    "Common": {
      "type": "object",
      "description": "OS-wide constants. SPEC B.4.2.",
      "required": [
        "Build",
        "OsShortName",
        "Edition",
        "Architecture"
      ],
      "properties": {
        "Build": {
          "type": "integer"
        },
        "OsShortName": {
          "type": "string"
        },
        "Edition": {
          "type": "string"
        },
        "Architecture": {
          "type": "string",
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "WimEdition": {
          "type": "string"
        },
        "InstallWimIndex": {
          "type": "integer"
        },
        "BootWimIndexes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "WinReWimPath": {
          "type": "string"
        },
        "SupportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "DefaultLanguage": {
          "type": "string"
        },
        "LCUExpandViaMum": {
          "type": "boolean"
        },
        "EnableInstallWimUpdate": {
          "type": "boolean"
        },
        "BootWimLcuPolicy": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "tolerate"
          ],
          "description": "Per-OS boot.wim LCU-servicing policy (r11.54; replaces the boolean EnableBootWimUpdate -- destructive rename, no shim). The 2026-07-05 4-OS E2E proved boot.wim LCU-serviceability is a per-media property: enabled = strict apply (2016: WinPE 1607 accepts the LCU and materialises the PCA2023 EFI_EX/FONTS_EX/DVD_EX staging set; 2025: r11.52 checkpoint-model target-only apply); disabled = leave boot.wim as shipped, WinRE servicing still runs (2019 EVAL media: structurally closed, 0x80070032 at CBS finalize, D1 probe 2026-06-12); tolerate = attempt, downgrade failure to a Caution, dismount -Discard, continue (2022: serviceability unmeasured). Missing value defaults to disabled at profile hydration."
        },
        "EnableWinREUpdate": {
          "type": "boolean"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance (e.g. _VerifiedDate, _VerifiedBy)."
        }
      },
      "additionalProperties": false
    },
    "PatchBaseline": {
      "type": "object",
      "description": "Patch Tuesday cadence baseline. SPEC B.4.3. Resolved patch files live in Lines[] (a common-core item with a Kind field). The legacy 'Patches' and 'NeutralPatches' field names are forbidden (destructive rebuild; the data-source migration to the Microsoft Update Catalog replaced NeutralPatches[]/Type with Lines[]/Kind).",
      "required": [
        "Lines"
      ],
      "properties": {
        "Schema": {
          "type": "string",
          "const": "3.0"
        },
        "TargetBuildAfterUpdate": {
          "type": "string"
        },
        "PatchTuesdayOfBaseline": {
          "type": "string"
        },
        "LastVerifiedDate": {
          "type": "string"
        },
        "LastVerifiedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "ChecksumAlgorithm": {
          "type": "string",
          "description": "Checksum algorithm for Lines[].Digest. SHA1 (the Catalog Digest is SHA-1 base64 -- the verified cross-source key)."
        },
        "BridgeLcu": {
          "type": "object",
          "description": "OPTIONAL static per-OS bridge LCU (SEED; servicing-policy). Present only when the OS's committed source media ships a servicing stack OLDER than the floor the current combined LCU requires (axis 3: image-side servicing-stack floor). Basis (MS primary, per-KB pages, e.g. KB5094128 for Server 2022): 'Make sure that your image includes KB5030216 (09/12/2023) or a later LCU. If not, install it on your offline media before you install the latest update.' -- the floor that prevents 0x800f0823 (CBS_E_NEW_SERVICING_STACK_REQUIRED). P02 materialises this envelope as a ResolvedPatches entry (PatchType 'BridgeLcu', Install-only) and P07 applies it FIRST (sub-phase I0) on every targeted index, unconditionally when present [DECIDED 2026-07-06, A1]. It is NOT a Lines[] member (Lines are DERIVED; the bridge is static policy) and lands in the flat patches folder, never in the cu discovery subfolder.",
          "required": [
            "KbId",
            "FileName",
            "DownloadUrl",
            "Digest",
            "MinimumImageServicingStack",
            "EvidenceUrl"
          ],
          "properties": {
            "KbId": {
              "type": "string"
            },
            "FileName": {
              "type": "string"
            },
            "DownloadUrl": {
              "type": "string"
            },
            "Digest": {
              "type": "string",
              "description": "Catalog SHA-1 base64 of the bridge .msu (same key convention as Lines[].Digest)."
            },
            "Sha256": {
              "type": "string"
            },
            "MinimumImageServicingStack": {
              "type": "string",
              "description": "The documented minimum image servicing-stack version the bridge satisfies (e.g. '20348.1960')."
            },
            "EvidenceUrl": {
              "type": "string",
              "description": "MS primary source documenting the floor + bridge requirement."
            },
            "Note": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "Lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Line"
          },
          "description": "Resolved patch files (LCU/SSU/DotNet/SafeOSDU/SetupDU). The canonical store under Config Schema v3.0; replaces the legacy NeutralPatches[]."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "Patches"
            ]
          },
          {
            "required": [
              "NeutralPatches"
            ]
          }
        ],
        "description": "FORBIDDEN legacy field names: 'Patches' (pre-v2.1 P03 r10.3 defect) and 'NeutralPatches' (pre-v3.0; replaced by 'Lines' at the Catalog data-source migration)."
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance."
        }
      },
      "additionalProperties": false
    },
    "Line": {
      "type": "object",
      "description": "A single resolved patch FILE-with-context (the common-core Lines[] item; mirrors the Catalog reference resolver _line() shape). SPEC B.4.3.",
      "required": [
        "Kind",
        "FileName",
        "DownloadUrl",
        "Digest",
        "ApplyOrder"
      ],
      "properties": {
        "Kind": {
          "type": "string",
          "enum": [
            "LCU",
            "SSU",
            "Checkpoint",
            "DotNet",
            "SafeOSDU",
            "SetupDU"
          ],
          "description": "Patch class. The PatchModel discriminator (top-level) governs which Kinds are required vs forbidden."
        },
        "KbId": {
          "type": [
            "string",
            "null"
          ]
        },
        "UpdateId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Catalog updateID GUID. For UUP (2025) lines this may differ from the SOAP oracle revision; Digest is the cross-source key."
        },
        "Title": {
          "type": [
            "string",
            "null"
          ]
        },
        "Products": {
          "type": [
            "string",
            "null"
          ],
          "description": "Catalog Products column."
        },
        "Classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "FileName": {
          "type": "string",
          "description": "Resolved file name (ends in the 40-hex SHA-1)."
        },
        "DownloadUrl": {
          "type": "string",
          "description": "Direct CDN download URL."
        },
        "Digest": {
          "type": "string",
          "minLength": 1,
          "description": "[Legacy v3 path] Same-artifact identity + integrity: the Catalog Digest (SHA-1, base64) of the served byte container. Every downloaded file MUST be verified against this; a mismatch MUST abort the build."
        },
        "Sha256": {
          "type": "string",
          "description": "Optional SHA-256 (usually empty; Digest is the load-bearing checksum)."
        },
        "SizeBytes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ApplyOrder": {
          "type": "integer",
          "description": "Per-OS apply sequence (a VARIANT value owned by the PatchModel branch)."
        },
        "InScope": {
          "type": [
            "object",
            "null"
          ],
          "description": "Kind-specific scoping (e.g. LCU {build}; SSU 2016 {standalone:true} / 2025 {checkpointBaseline:true}; DotNet {ndpTag,runtime}; SafeOSDU {target:'winre'})."
        },
        "Note": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance."
        }
      },
      "additionalProperties": false
    },
    "Pca2023": {
      "type": "object",
      "description": "Per-OS Secure Boot (PCA2023) conversion defaults. SPEC B.4.4.",
      "properties": {
        "RequiredByDefault": {
          "type": "boolean"
        },
        "RequiredUpdateLevelKb": {
          "type": [
            "string",
            "null"
          ]
        },
        "RequiredUpdateLevelMinDate": {
          "type": "string"
        },
        "NotesSource": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "Notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance."
        }
      },
      "additionalProperties": false
    },
    "AutoRefreshPolicy": {
      "type": "object",
      "description": "Baseline auto-refresh policy. SPEC B.14.",
      "properties": {
        "Mode": {
          "type": "string"
        },
        "WritebackToConfig": {
          "type": "boolean"
        },
        "FallbackOnScrapeFailure": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "ScrapeRetries": {
          "type": "integer"
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance."
        }
      },
      "additionalProperties": false
    },
    "LanguageSpecific": {
      "type": "object",
      "description": "Per-language ISO snapshot + language-specific patches. SPEC B.4.5. Keys are BCP-47 language tags (e.g. en-us, ja-jp).",
      "patternProperties": {
        "^[a-z]{2}-[a-z]{2}$": {
          "$ref": "#/definitions/LanguageEntry"
        }
      },
      "additionalProperties": false
    },
    "LanguageEntry": {
      "type": "object",
      "properties": {
        "DisplayName": {
          "type": "string"
        },
        "Iso": {
          "type": "object",
          "description": "Per-language source-ISO record. Url is the download source (consumed by Resolve-IsoSourceUrl); Sha256 is the expected image hash (consumed by the P04 integrity check). Underscore keys are human provenance stamps. Reader-less fields (FileName / FwlinkUrl / SizeBytes / ReleaseDate) were retired; additionalProperties=false keeps them from creeping back.",
          "properties": {
            "Url": {
              "type": "string"
            },
            "Sha256": {
              "type": "string"
            },
            "_VerifiedDate": {
              "type": "string"
            },
            "_VerifiedBy": {
              "type": "string"
            }
          },
          "required": [
            "Url",
            "Sha256"
          ],
          "additionalProperties": false
        },
        "VolumeLabelPrefix": {
          "type": "string"
        },
        "LanguageSpecificPatches": {
          "type": "object",
          "description": "Per-language patch groups (LanguagePacks, LxpUpdates, DotNetLanguagePacks) plus verification metadata.",
          "patternProperties": {
            "^_": {}
          },
          "additionalProperties": true
        }
      },
      "patternProperties": {
        "^_": {
          "description": "Machine-written provenance."
        }
      },
      "additionalProperties": false
    }
  }
}
