# ShellCheck project configuration - bash-rhel-container-testsuite
#
# Policy: every ShellCheck code stays ACTIVE project-wide. The canonical L0
# severity is `style` (the strictest), enforced on the command line by
# tests/t002_shellcheck.sh (see TESTING.md "Test model"). This file deliberately
# declares NO global `disable=` - it would weaken the gate everywhere. Any
# exemption must be a narrow, documented, inline `# shellcheck disable=`/`source=`
# directive at the relevant statement, decided once in the diff with a rationale.
#
# `external-sources=true` + `source-path=SCRIPTDIR` let ShellCheck FOLLOW the
# harness's `# shellcheck source=lib/...` directives (resolving SC1091 properly
# rather than suppressing it) - this strengthens checking, it does not relax it.
external-sources=true
source-path=SCRIPTDIR
