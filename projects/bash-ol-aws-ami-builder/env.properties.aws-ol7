#==============================================================================
# env.properties.aws-ol7
#
# Environment configuration for building an Oracle Linux 7 AWS AMI.
# Loaded by build-ol-aws-ami.sh via the --env option.
#
# Companion files for other Oracle Linux versions:
#   env.properties.aws-ol10  (Oracle Linux 10.x)
#   env.properties.aws-ol9   (Oracle Linux 9.x)
#   env.properties.aws-ol8   (Oracle Linux 8.x)
#
#==============================================================================
# !!! IMPORTANT DEPRECATION NOTICE !!!
#==============================================================================
# Oracle Linux 7 is EOL for Premier Support (ended 2024-12-31). The upstream
# oracle-linux-image-tools project explicitly EXCLUDES Oracle Linux 7 from its
# AWS cloud target via a hard-coded check in cloud/aws/image-scripts.sh:
#
#   [[ ${ORACLE_RELEASE} -lt 8 ]] && common::error "AWS images builder only supports OL8 and above"
#
# build-ol-aws-ami.sh works around this by automatically patching that line
# in the cloned tooling when OL_MAJOR_VERSION == 7. As a result:
#
#   * This template is intended for verification, learning, and legacy
#     migration scenarios. Do NOT use the resulting AMI for production
#     workloads requiring Oracle Premier Support coverage.
#   * The upstream tool may break OL7 support without warning in a future
#     refactor. When that happens, the patch in build-ol-aws-ami.sh will
#     need to be re-evaluated.
#   * Oracle Linux 7 only supports x86_64 (no aarch64) and BIOS boot
#     (no UEFI / NitroTPM / Secure Boot). The resulting AMI will boot on
#     every Nitro instance type but cannot enable UEFI-only features.
#
# If you need an actively supported Oracle Linux on AWS, prefer the OL8 / OL9
# / OL10 templates in this directory.
#==============================================================================

#------------------------------------------------------------------------------
# [Required] Parameters consumed by oracle-linux-image-tools
#------------------------------------------------------------------------------

# Workspace directory for the build. Requires 20GB+ of free space.
#
# Default: /tmp/ol7-build-ws (universally accessible; qemu user can reach it)
#
# Notes:
#   * /tmp is sometimes mounted as tmpfs (RAM-backed) on modern Linux.
#     If your host has less than ~32 GB RAM, /tmp may be too small.
#     The script will detect this and warn at runtime.
#   * /tmp is cleared on reboot. If your build may span a reboot, prefer
#     /var/tmp/ol7-build-ws (persistent, typically disk-backed).
#   * Avoid placing WORKSPACE under /root or any directory without world
#     traverse (x) permission; otherwise libvirt's qemu user cannot reach
#     the build artifacts. (Phase 2 mitigates this via setfacl, but
#     /tmp avoids the problem entirely.)
WORKSPACE="/tmp/ol7-build-ws"

# Distribution slug (Oracle Linux 7 update 9 = ol7-slim)
DISTR="ol7-slim"

# Target cloud
CLOUD="aws"

# Oracle Linux 7 U9 x86_64 DVD ISO.
#
# Note the "Server-" infix in the OL7 filename — older Oracle naming
# convention that is preserved by parse_ol_version_from_iso and
# derive_oracle_checksum_url in build-ol-aws-ami.sh.
ISO_URL="https://yum.oracle.com/ISOS/OracleLinux/OL7/u9/x86_64/OracleLinux-R7-U9-Server-x86_64-dvd.iso"

# SHA256 checksum of the ISO.
#
# When unset, the script auto-resolves it in this order:
#   1. ${ISO_CHECKSUM_URL}                 (if you set it explicitly)
#   2. ${ISO_URL}.sha256sum                (legacy; returns 404 on yum.oracle.com
#                                           as of 2026-05; some third-party mirrors
#                                           may still publish it)
#   3. https://linux.oracle.com/security/gpg/checksum/OracleLinux-R7-U9-Server-x86_64.checksum
#      (Oracle-published GPG-signed checksum; the reliable path for all
#       supported OL versions)
#
# For OL7, route #3 is now the reliable path. The legacy route #2 used to be
# the primary route for OL7 mirrors but Oracle's official yum server no longer
# publishes per-file .sha256sum companions; the script falls through to
# route #3 automatically when route #2 returns 404.
#
# Verified-good SHA256 (as of 2026-05):
# ISO_CHECKSUM="28d2928ded40baddcd11884b9a6a611429df12897784923c346057ec5cdd1012"

#------------------------------------------------------------------------------
# [Optional] Image customization
#------------------------------------------------------------------------------

# OS variant short-id used by virt-install / osinfo-query.
# When unset, the script auto-detects a usable value from the local osinfo-db
# in this priority order:
#   oraclelinux7.x -> oraclelinux7 -> rhel7.x -> centos7 ->
#   linux2018      -> linux2016
#
# Notes:
#   * Oracle Linux 7 is binary-compatible with RHEL 7. If your osinfo-db
#     does not have 'oraclelinux7' entries (common on RHEL 7 hosts), the
#     script will pick 'rhel7.9' (or rhel7.8) and the resulting build is
#     functionally equivalent. No action required in this case.
#   * If you want the native 'oraclelinux7' entry, install the latest
#     osinfo-db tarball from https://releases.pagure.org/libosinfo/ via
#     'sudo osinfo-db-import --system osinfo-db-XXXXXX.tar.xz'.
#
# To verify what your osinfo-db has:
#   osinfo-query os --fields=short-id | grep -E "(oraclelinux7|rhel7|centos7)"
# To override manually:
# OS_VARIANT="rhel7.9"

# libguestfs backend (direct / libvirt).
#
# Default: "direct" (set by the script in phase4_run_build)
#
# Why "direct" is the default:
#   virt-sparsify creates a temporary overlay subdirectory under the
#   workspace using mkdtemp(3), which always sets mode 0700. The libvirt
#   'qemu' user (uid 107) cannot traverse such a directory, causing the
#   build to fail at the very last step. Running libguestfs with the
#   "direct" backend bypasses libvirt and lets qemu run as the calling
#   user (root in most build host setups), avoiding the issue.
#
# Override only if you have a specific reason to route libguestfs through
# libvirt and you have separately ensured the qemu user can access every
# transient directory created during the build.
# LIBGUESTFS_BACKEND="direct"

# Build number (used as a suffix in output filenames)
BUILD_NUMBER="0"

# Swap configuration (typically not needed on cloud VMs).
#
# Note: the upstream OL7 distribution default is "yes", but for AWS we
# keep it "No" to align with the OL8/9/10 templates and avoid an extra
# swap partition on EBS-backed cloud volumes.
SETUP_SWAP="No"

# SELinux mode (enforcing / permissive / disabled)
SELINUX="enforcing"

# Root filesystem (xfs / btrfs)
# Note: OL7 does NOT support lvm at this layer (lvm support was added in OL8+).
ROOT_FS="xfs"

# Root volume size of the AMI (GB)
DISK_SIZE_GB="10"

# Enable serial console at runtime (required for the EC2 Serial Console)
SERIAL_CONSOLE_RUNTIME="Yes"

# Build-time boot mode (bios / uefi / hybrid).
#
# IMPORTANT: Two independent constraints both require "bios" for OL7+AWS:
#   1. oracle-linux-image-tools enforces "bios" for the AWS cloud target
#      (cloud/aws/image-scripts.sh: "AWS images only supports bios BOOT_MODE").
#   2. oracle-linux-image-tools enforces "bios" for any OL7 build regardless
#      of cloud target (bin/build-image.sh: "OL7 only supports bios BOOT_MODE").
# Setting "uefi" or "hybrid" here will cause build-image.sh to abort.
BOOT_MODE_BUILD="bios"

# Kernel selection (uek or rhck).
#
# IMPORTANT for OL7+AWS:
#   * The upstream cloud/aws/provision.sh installs "kernel-uek-modules"
#     when KERNEL=uek and "kernel-modules" when KERNEL=rhck. On OL7 with
#     the RHCK kernel, modules are bundled into the main "kernel" package
#     and there is NO separate "kernel-modules" package, so KERNEL=rhck
#     will fail during provision.
#   * Therefore, leave KERNEL="uek" for OL7 builds targeting AWS. UEK6
#     includes the Amazon ENA driver and matches the upstream OL7 default.
KERNEL="uek"

# UEK release for OL7 (5 or 6). UEK6 is the latest supported on OL7 and is
# required for current AWS Nitro hardware compatibility (ENA / NVMe).
UEK_RELEASE="6"

# Whether to keep the linux-firmware package. "No" is recommended on VMs
# (no GPU passthrough), since it shrinks the image significantly.
# Note: the upstream OL7 default is "yes". On OL7 kernel packages have
# an install dependency on linux-firmware, so it may be reinstalled when
# a new kernel is installed.
# LINUX_FIRMWARE="No"

# Root password (libguestfs virt-builder format)
# Prefer cloud-init for production. Use this only for debugging.
# ROOT_PASSWORD="password:ChangeMe123!"

# Root SSH public key
# ROOT_SSH_KEY="file:${HOME}/.ssh/id_rsa.pub"

# Enable cloud-init (set to "Yes" on AWS to provision ec2-user, etc.)
CLOUD_INIT="Yes"
CLOUD_USER="ec2-user"

# RPM update policy applied during provisioning.
#
# Values:
#   "yes"      Run `yum update -y` inside the guest after the base install,
#              bringing every package (including kernel-uek) up to the
#              latest version available in the OL7 yum repositories. This
#              addresses any kernel or userspace vulnerability discovered
#              after the ISO was cut.
#   "security" Apply only security-tagged updates via yum-plugin-security.
#   "no"       Skip the update step; the AMI ships only the ISO packages.
#              NOT recommended given OL7 is EOL and security exposure is high.
#
# This value is propagated through Phase 4 of build-ol-aws-ami.sh into the
# upstream distr/ol7-slim/provision.sh distr::configure routine. Without an
# explicit setting here the upstream distr default of "yes" applies; the
# explicit declaration makes the behaviour visible to operators.
UPDATE_TO_LATEST="yes"

#------------------------------------------------------------------------------
# [Required] AWS import parameters
#------------------------------------------------------------------------------

# Region in which the AMI will be created.
#
# When this value is empty (or unset), build-ol-aws-ami.sh resolves it
# dynamically at runtime via EC2 Instance Metadata Service:
#   1. IMDSv2 (token-based; preferred)
#   2. IMDSv1 (legacy; used only if IMDSv2 fails)
#   3. Fallback constant "ap-northeast-1" (used outside EC2)
#
# Set an explicit region here to override the auto-detection.
AWS_REGION=""

# S3 bucket used as the staging area for the VMDK upload.
# Created automatically (with public access blocked) if it does not exist.
#
# Shared across all OL versions in this directory (env.properties.aws-ol{6,7,
# 8,9,10}). The S3_KEY_PREFIX below provides per-version isolation, so the
# single vmimport IAM role policy created by setup-vmimport-role.sh covers
# every version's import.
S3_BUCKET="my-oracle-linux-ami-import-bucket"

# Key prefix inside the S3 bucket
S3_KEY_PREFIX="ol7-ami-import"

# AMI name (defaults to a timestamped name when unset)
# AMI_NAME="OracleLinux-7-U9-x86_64-$(date +%Y%m%d)"

# AMI description
# AMI_DESCRIPTION="Oracle Linux 7 Update 9 (x86_64) custom AMI"

# AMI boot mode (uefi-preferred / uefi / legacy-bios)
#
# IMPORTANT: must match what BOOT_MODE_BUILD produces.
#   * BOOT_MODE_BUILD="bios"   -> set BOOT_MODE="legacy-bios"  (REQUIRED for OL7+AWS)
#
# OL7 cannot produce UEFI or hybrid images, so legacy-bios is the only
# working combination. The AMI will still boot on every Nitro-based
# instance type (M5/C5/M6i/M8i/etc.).
BOOT_MODE="legacy-bios"

# Name of the vmimport IAM role (must match setup-vmimport-role.sh)
VMIMPORT_ROLE_NAME="vmimport"
