#==============================================================================
# env.properties.aws-ol8
#
# Environment configuration for building an Oracle Linux 8 AWS AMI.
# Loaded by build-ol-aws-ami.sh via the --env option.
#
# Companion files for other Oracle Linux versions:
#   env.properties.aws-ol10  (Oracle Linux 10.x)
#   env.properties.aws-ol9   (Oracle Linux 9.x)
#   env.properties.aws-ol7   (Oracle Linux 7.x — deprecated / verification use only)
#==============================================================================

#------------------------------------------------------------------------------
# [Required] Parameters consumed by oracle-linux-image-tools
#------------------------------------------------------------------------------

# Workspace directory for the build. Requires 20GB+ of free space.
#
# Default: /tmp/ol8-build-ws (universally accessible; qemu user can reach it)
#
# Notes:
#   * /tmp is sometimes mounted as tmpfs (RAM-backed) on modern Linux.
#     If your host has less than ~32 GB RAM, /tmp may be too small.
#     The script will detect this and warn at runtime.
#   * /tmp is cleared on reboot. If your build may span a reboot, prefer
#     /var/tmp/ol8-build-ws (persistent, typically disk-backed).
#   * Avoid placing WORKSPACE under /root or any directory without world
#     traverse (x) permission; otherwise libvirt's qemu user cannot reach
#     the build artifacts. (Phase 2 mitigates this via setfacl, but
#     /tmp avoids the problem entirely.)
WORKSPACE="/tmp/ol8-build-ws"

# Distribution slug (Oracle Linux 8 update 10 = ol8-slim)
DISTR="ol8-slim"

# Target cloud
CLOUD="aws"

# Oracle Linux 8 U10 x86_64 DVD ISO
ISO_URL="https://yum.oracle.com/ISOS/OracleLinux/OL8/u10/x86_64/OracleLinux-R8-U10-x86_64-dvd.iso"

# SHA256 checksum of the ISO.
#
# When unset, the script auto-resolves it in this order:
#   1. ${ISO_CHECKSUM_URL}                 (if you set it explicitly)
#   2. ${ISO_URL}.sha256sum                (legacy; returns 404 on yum.oracle.com
#                                           as of 2026-05; some third-party mirrors
#                                           may still publish it)
#   3. https://linux.oracle.com/security/gpg/checksum/OracleLinux-R8-U10-Server-x86_64.checksum
#      (Oracle-published GPG-signed checksum; the reliable path for all
#       supported OL versions)
#
# Route #3 is the reliable path. The script falls through to route #3
# automatically when route #2 returns 404.
#
# Verified-good SHA256 (as of 2026-05):
# ISO_CHECKSUM="7676a80eeaafa16903eebb2abba147a3afe230b130cc066d56fdd6854d8da900"

#------------------------------------------------------------------------------
# [Optional] Image customization
#------------------------------------------------------------------------------

# OS variant short-id used by virt-install / osinfo-query.
# When unset, the script auto-detects a usable value from the local osinfo-db
# in this priority order:
#   oraclelinux8.x -> oraclelinux8 -> rhel8.x -> centos-stream8 ->
#   oraclelinux9.x  -> linux2024     -> linux2023 -> linux2022
#
# Notes:
#   * Oracle Linux 8 is binary-compatible with RHEL 8. If your osinfo-db
#     does not have 'oraclelinux8' entries (common on RHEL 8 hosts), the
#     script will pick 'rhel8.1' (or rhel8.0) and the resulting build is
#     functionally equivalent. No action required in this case.
#   * If you want the native 'oraclelinux8' entry, install the latest
#     osinfo-db tarball from https://releases.pagure.org/libosinfo/ via
#     'sudo osinfo-db-import --system osinfo-db-XXXXXX.tar.xz'.
#
# To verify what your osinfo-db has:
#   osinfo-query os --fields=short-id | grep -E "(oraclelinux|rhel|linux2)"
# To override manually:
# OS_VARIANT="rhel8.10"

# libguestfs backend (direct / libvirt).
#
# Default: "direct" (set by the script in phase4_run_build)
#
# Why "direct" is the default:
#   virt-sparsify creates a temporary overlay subdirectory under the
#   workspace using mkdtemp(3), which always sets mode 0700. The libvirt
#   'qemu' user (uid 107) cannot traverse such a directory, causing the
#   build to fail at the very last step. Running libguestfs with the
#   "direct" backend bypasses libvirt and lets qemu run as the calling
#   user (root in most build host setups), avoiding the issue.
#
# Override only if you have a specific reason to route libguestfs through
# libvirt and you have separately ensured the qemu user can access every
# transient directory created during the build.
# LIBGUESTFS_BACKEND="direct"

# Build number (used as a suffix in output filenames)
BUILD_NUMBER="0"

# Swap configuration (typically not needed on cloud VMs)
SETUP_SWAP="No"

# SELinux mode (enforcing / permissive / disabled)
SELINUX="enforcing"

# Root filesystem (xfs / btrfs / lvm)
ROOT_FS="xfs"

# Root volume size of the AMI (GB).
# 7 GB uniform across OL6-10 (aligned with Oracle's own AWS AMIs). The root
# partition is created with --grow and cloud-utils-growpart is baked into the
# image, so instances launched with a larger EBS volume expand automatically:
# this value is a floor, not a ceiling. Per-OS measured footprints and the
# sizing rationale live in SPEC.md (B.3, "Disk sizing").
DISK_SIZE_GB="7"

# Amazon Time Sync Service (opt-in; default "no").
# When "yes" (or when the --enable-amazon-time-sync switch is passed), guest
# provisioning appends the link-local Amazon Time Sync server
# (169.254.169.123) as the PREFERRED source to /etc/chrony.conf (OL7-10) or
# /etc/ntp.conf (OL6), keeping the distribution pool lines as fallback.
# Default "no" by design: time configuration belongs to the end user of the
# AMI, so the builder does not change the distribution default unless asked.
AMAZON_TIME_SYNC="no"

# [Optional] ENA driver user pin (emergency lever; leave unset normally).
# When set to a concrete x.y.z, it becomes the HIGHEST-priority source for
# the self-built ENA driver version on every OL major: it enters the AMI
# name/description AND is passed into the guest hook, so identity and the
# built module stay in lock-step. When unset (default), the chain is:
# installer pin (OL6/7) -> amzn-drivers latest (OL8/9/10) -> fallback pin.
# ENA_DRIVER_VERSION="2.17.0"

# Install-time serial console. Default "no" (headless): upstream detects
# install completion and applies its own timeout -- the reliable path. "yes"
# makes upstream wait on `virsh console`, which may NOT return when the install
# VM ends and can hang the build until BUILD_TIMEOUT_MIN (observed even on
# successful builds); use "yes" only to watch the install live on OL6/7 and be
# ready to kill the VM. See SPEC A.7 / D.18.
SERIAL_CONSOLE="no"

# Enable serial console at runtime (required for the EC2 Serial Console)
SERIAL_CONSOLE_RUNTIME="Yes"

# Build-time boot mode (bios / uefi / hybrid).
#
# IMPORTANT: oracle-linux-image-tools currently enforces "bios" for the AWS
# cloud target. Setting "uefi" or "hybrid" will cause build-image.sh to
# abort with: "AWS images only supports bios BOOT_MODE".
# Leave this as "bios" unless the upstream tool removes that restriction.
BOOT_MODE_BUILD="bios"

# Kernel selection (uek or rhck)
# Both work on AWS. ENA / NVMe drivers are included with either one.
# KERNEL="uek"

# Whether to keep the linux-firmware package. "No" is recommended on VMs
# (no GPU passthrough), since it shrinks the image significantly.
# LINUX_FIRMWARE="No"

# Root password (libguestfs virt-builder format)
# Prefer cloud-init for production. Use this only for debugging.
# ROOT_PASSWORD="password:ChangeMe123!"

# Root SSH public key
# ROOT_SSH_KEY="file:${HOME}/.ssh/id_rsa.pub"

# Enable cloud-init (set to "Yes" on AWS to provision ec2-user, etc.)
CLOUD_INIT="Yes"
CLOUD_USER="ec2-user"

# RPM update policy applied during provisioning.
#
# Values:
#   "yes"      Run `dnf update -y` inside the guest after the base install,
#              bringing every package (including kernel-uek / kernel) up to
#              the latest version available in the OL8 dnf repositories.
#              Critical for kernel-level vulnerability remediation between
#              ISO release and AMI deployment.
#   "security" Apply only security-tagged updates.
#   "no"       Skip the update step; the AMI ships only the ISO packages.
#              NOT recommended.
#
# This value is propagated through Phase 4 of build-ol-aws-ami.sh into the
# upstream distr/ol8-slim/provision.sh distr::configure routine. Without an
# explicit setting here the upstream distr default of "yes" applies; the
# explicit declaration makes the behaviour visible to operators.
UPDATE_TO_LATEST="yes"

# Retain the linux-firmware package in the image? ("yes" / "no")
#
# "no" for the OL8 AWS AMI (2026-07-13 adjudication, measured root cause):
#   - Firmware blobs are device-side payloads for physical hardware; on EC2
#     (Nitro VM: ENA NIC + NVMe) the guest loads none of them. Upstream
#     oracle-linux-image-tools itself states "Linux firmware is not needed on
#     VM instances" and provides this knob.
#   - EL8 is the ONLY major whose linux-firmware ships uncompressed
#     (~1.9 GB installed; EL9/EL10 use xz-compressed firmware at ~0.9 GB and
#     their ol9/ol10-slim distrs already remove firmware entirely via their
#     KERNEL_MODULES="no" default). Keeping it made the OL8 UPDATE_TO_LATEST
#     transaction overflow the 7 GB root ("needs 631MB more on /",
#     2026-07-13 build), the only major to do so.
#   - No dependency cascade: the slim build's KERNEL_MODULES="no" default has
#     already removed kernel-uek-modules (the only linux-firmware requirer on
#     UEK7); kernel-uek-core keeps its own linux-firmware-core (small), which
#     is NOT touched by this knob.
# This converges OL8 with the OL9/OL10 image content (no bulk firmware) and
# preserves the uniform DISK_SIZE_GB=7. See SPEC B.3.4.
LINUX_FIRMWARE="no"

#------------------------------------------------------------------------------
# [Required] AWS import parameters
#------------------------------------------------------------------------------

# Region in which the AMI will be created.
#
# When this value is empty (or unset), build-ol-aws-ami.sh resolves it
# dynamically at runtime via EC2 Instance Metadata Service:
#   1. IMDSv2 (token-based; preferred)
#   2. IMDSv1 (legacy; used only if IMDSv2 fails)
#   3. Fallback constant "ap-northeast-1" (used outside EC2)
#
# Set an explicit region here to override the auto-detection.
AWS_REGION=""

# S3 bucket used as the staging area for the VMDK upload.
# Created automatically (with public access blocked) if it does not exist.
#
# Shared across all OL versions in this directory (env.properties.aws-ol{6,7,
# 8,9,10}). The S3_KEY_PREFIX below provides per-version isolation, so the
# single vmimport IAM role policy created by setup-vmimport-role.sh covers
# every version's import.
S3_BUCKET="my-oracle-linux-ami-import-bucket"

# Key prefix inside the S3 bucket
S3_KEY_PREFIX="ol8-ami-import"

# AMI name (defaults to a timestamped name when unset)
# AMI_NAME="OracleLinux-8-U10-x86_64-$(date +%Y%m%d)"

# AMI description
# AMI_DESCRIPTION="Oracle Linux 8 Update 10 (x86_64) custom AMI"

# AMI boot mode (uefi-preferred / uefi / legacy-bios)
#
# IMPORTANT: must match what BOOT_MODE_BUILD produces.
#   * BOOT_MODE_BUILD="bios"   -> set BOOT_MODE="legacy-bios"  (REQUIRED for AWS)
#   * BOOT_MODE_BUILD="uefi"   -> set BOOT_MODE="uefi"
#   * BOOT_MODE_BUILD="hybrid" -> set BOOT_MODE="uefi-preferred"
#
# Since oracle-linux-image-tools restricts AWS builds to bios-only images,
# the only working combination today is legacy-bios. The AMI will still
# boot on every Nitro-based instance type (M5/C5/M6i/M8i/etc.).
BOOT_MODE="legacy-bios"

# Name of the vmimport IAM role (must match setup-vmimport-role.sh)
VMIMPORT_ROLE_NAME="vmimport"
